# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# JWT secret — REQUIRED. The app refuses to start if this is unset or left at
# the old default, since a known secret makes every auth token forgeable.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

# Canonical public base URL, no trailing slash. Used for challenge share links
# and the Lemon Squeezy checkout redirect. Set this in production:
#   APP_BASE_URL=https://mirrorspeak.app
# Leave it unset locally — in-app links then stay relative and follow whatever
# host you are browsing.
APP_BASE_URL=

# ─── Which payment provider is live ──────────────────────────────────────────
# "lemonsqueezy" (default) or "polar". Unset means lemonsqueezy, so deploying
# the Polar code changes nothing until this is set.
#
# One switch covers all of it: the checkout, the webhook signature scheme, the
# event names, the cancel-on-account-deletion call and which id column that
# cancel reads. Entitlements are provider-agnostic, so rows granted by either
# provider are indistinguishable afterwards and the gate never learns which
# one paid.
BILLING_PROVIDER=

# ─── Polar billing ───────────────────────────────────────────────────────────
# Organization access token. Scopes needed: checkouts:write,
# subscriptions:write, customer_sessions:write, products:read.
#
# SANDBOX AND PRODUCTION TOKENS ARE NOT INTERCHANGEABLE. The two environments
# are fully isolated -- separate dashboards, separate data, separate tokens --
# so this has to be set as a pair with POLAR_SERVER below.
POLAR_ACCESS_TOKEN=

# "sandbox" or "production" (default). Picks the API host:
#   sandbox     https://sandbox-api.polar.sh   dashboard sandbox.polar.sh
#   production  https://api.polar.sh
# Sandbox test card: 4242 4242 4242 4242, any future expiry, any CVC.
POLAR_SERVER=

# API version to pin. Polar keeps three alive at a time -- Next, Current and
# Deprecated -- and rotates them in the first week of January, April, July and
# October; a version lives about nine months in total. Omitting the header does
# not mean "whatever we built against", it means Current, which changes under
# you every quarter.
#
# Defaults to 2026-10, which was Current when this integration was written and
# verified against the sandbox. THE WEBHOOK ENDPOINT IN THE POLAR DASHBOARD
# MUST BE SET TO THE SAME VERSION -- otherwise checkouts are created under one
# contract and deliveries are parsed under another.
#
# Do not move this to the Next version (2027-01 at time of writing) just because
# it is newer: schema changes land in Next, so it can still move before it
# becomes Current.
POLAR_API_VERSION=2026-10

# Webhook signing secret (whsec_...). Without it /api/billing/webhook fails
# closed with 503 rather than trusting an unsigned body.
#
# Polar signs with Standard Webhooks for every secret generated on or after
# 8 September 2026, which is every secret that can be created now. Only that
# scheme is implemented; an older secret predating the cutover will not verify.
POLAR_WEBHOOK_SECRET=

# Product IDs (UUIDs) from the Polar dashboard, for the environment above.
# As with Lemon Squeezy variants, sandbox and production ids differ.
POLAR_MONTHLY_PRODUCT_ID=
POLAR_YEARLY_PRODUCT_ID=
# Optional. The $1 one-time Starter Pack (the five scenes marked starter=true
# in docs/original-scenes.json); omit to hide the button entirely.
#
# This was POLAR_LEVEL1_PRODUCT_ID while the $1 product was all of Level 1.
# The old name still works and logs a "[config]" warning at boot, so an
# environment that has not been updated deploys rather than losing checkout.
POLAR_STARTER_PRODUCT_ID=

# Organization slug, used only for the fallback portal link
# (polar.sh/<slug>/portal) shown to a subscriber whose subscription we could
# not cancel for them. Pre-authenticated links are minted per click from the
# customer id instead -- Polar sessions are short-lived, so unlike the Lemon
# Squeezy portal URL there is nothing to store.
POLAR_ORG_SLUG=

# ─── Lemon Squeezy billing ───────────────────────────────────────────────────
# Read only while BILLING_PROVIDER is lemonsqueezy (the default).
# All four are read by main.py. Leave them unset to run without billing: the
# checkout endpoint then returns 500 "Payment not configured" and the webhook
# returns 503, while the rest of the app works normally.

# Webhook signing secret. Without it, /api/billing/webhook fails closed
# (rejects every request with 503) rather than skipping verification.
LEMONSQUEEZY_SIGNING_SECRET=

# API key — https://app.lemonsqueezy.com/settings/api
# Used to create checkouts and to cancel a subscription when its owner deletes
# their account. Without it, an account deletion by a subscriber is refused
# (409) rather than leaving the subscription billing a deleted account.
LEMONSQUEEZY_API_KEY=

# Variant IDs. /api/billing/checkout accepts only the values set here, and
# /api/billing/plans serves the same set to the client -- so the ids exist in
# one place and going live is a config change, not a code change.
#
# The dashboard shows product ids, not variant ids. Get variant ids from the
# API with:  python scripts/ls-catalog.py
#
# TEST AND LIVE STORES HAVE DIFFERENT VARIANT IDS. Swapping the API key
# without swapping these gives 400 "Invalid variant" on every checkout.
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_YEARLY_VARIANT_ID=

# Optional. One-time purchase for the Starter Pack; omit to hide it entirely.
# Formerly LEMONSQUEEZY_LEVEL1_VARIANT_ID, which still works with a warning.
LEMONSQUEEZY_STARTER_VARIANT_ID=

# Store id. Lemon Squeezy keeps one id across test and live, so this rarely
# changes; it defaults to 396208 when unset.
LEMONSQUEEZY_STORE_ID=

# Whether the entitlement gate actually refuses anything. Unset or false means
# no scene is ever refused and the UI shows no lock that offers to sell
# something -- the behaviour from before the gate existed.
#
# Turn this on LAST, and only once a real purchase has completed end to end.
# While the store cannot take a payment, refusing a scene gives the user
# nothing they can do about it: it is a paywall with no way through. The
# failure is also silent, since someone locked out of a product they cannot buy
# does not report a bug.
#
# Accepts 1 / true / yes / on. Every boot logs which state it resolved to;
# look for "[gate] ENFORCE_ENTITLEMENTS=" in the Render log.
ENFORCE_ENTITLEMENTS=

# PostgreSQL connection URL (Render sets this automatically when you attach a database)
# Leave unset (or don't define it) to use SQLite for local development
# DATABASE_URL=postgresql://user:password@host:5432/dbname
